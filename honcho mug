local Unload = function()
    Alive = false
    MorphActive = false
    CutsceneActive = false
    pcall(RunService.UnbindFromRenderStep, RunService, "HonchoThirdPerson")

    if CutsceneGui then
        CutsceneGui:Destroy()
        CutsceneGui = nil
    end

    if LiveHoncho then
        LiveHoncho:Destroy()
        LiveHoncho = nil
    end

    if Character then
        for _, Part in Character:QueryDescendants("BasePart, Decal, Texture") do
            Part.LocalTransparencyModifier = 0
        end
    end

    for _, Item in Connections do
        if typeof(Item) == "RBXScriptConnection" then
            Item:Disconnect()
        elseif typeof(Item) == "thread" then
            pcall(task.cancel, Item)
        end
    end

    table.clear(Connections)

    for Machine, Brew in pairs(Brewing) do
        if Brew.Visual then
            Brew.Visual:Destroy()
        end
        if Brew.Prompt then
            Brew.Prompt:Destroy()
        end
        if Brew.Drip then
            Brew.Drip:Destroy()
        end
        if Brew.Tool and Brew.Tool.Parent then
            Brew.Tool.Parent = LocalPlayer.Backpack
        end
        local MachinePrompt = Machine:FindFirstChild("InteractPrompt")
        if MachinePrompt then
            MachinePrompt.Enabled = true
        end
    end
    table.clear(Brewing)
end

