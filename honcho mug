local Create = function(class, properties)
    local Object = class
    properties = properties or {}

    if typeof(class) == "string" then
        Object = Instance.new(class)
    end

    for Property, Value in properties do
        if Property == "Parent" then continue end

        Object[Property] = Value
    end

    if properties.Parent then
        Object.Parent = properties.Parent
    end

    return Object
end

local FetchRemoteObject = function(path, devMode)
    if not isfolder("assets") then
        makefolder("assets")
    end

    if not isfolder("assets/upio") then
        makefolder("assets/upio")
    end

    if devMode then
        return game:GetObjects(getcustomasset(path))[1]
    end

    local AssetPath = `assets/upio/{path}`
    if not isfile(AssetPath) or readfile(AssetPath) == "" then
        writefile(AssetPath, game:HttpGet(`https://kardin-hong-upio-assets.pages.dev/{path}`))
    end

    return game:GetObjects(getcustomasset(AssetPath))[1]
end

