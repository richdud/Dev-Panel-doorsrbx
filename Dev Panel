if not PlayerGui then return end
do
  local version = (PlayerGui:GetAttribute("DoorsShopVisibilityVersion") or 0) + 1
    PlayerGui:SetAttribute("DoorsShopVisibilityVersion", version)

    local function show(parent, name)
        local obj = parent and parent:FindFirstChild(name)
        if obj and obj:IsA("GuiObject") then
            obj.Visible = true
        end
        return obj
    end

    local function update()
        -- TOPBAR
        local topUI = PlayerGui:FindFirstChild("TopbarUI")
        local top = topUI and topUI:FindFirstChild("Topbar")

        for _, name in ipairs({
            "EventCoins",
            "Gold",
            "Boosts"
        }) do
            show(top, name)
        end

        -- SHOP
        local global = PlayerGui:FindFirstChild("GlobalUI")
        local shop = global and global:FindFirstChild("Shop")
        local scroll = shop and shop:FindFirstChild("ScrollingShop")

        if scroll then
            for _, name in ipairs({
                "Collab",
                "Promo",
                "Seasonal",
                "SeasonalChrimah]",
                "_TrickOrTreatSeasonal",
                "AdminPanel",
                "GiftAdminPanel"
            }) do
                show(scroll, name)
            end

            -- KNOBS
            local knobs = scroll:FindFirstChild("Knobs")
            show(knobs, "7")
            show(knobs, "8")

            -- REWARDS AND PROMOS
            for _, obj in ipairs(scroll:GetDescendants()) do
                if obj:IsA("GuiObject") and (
                    obj.Name == "FinalReward"
                    or obj.Name == "FinalRewardOut"
                    or obj.Name == "WPromo"
                ) then
                    obj.Visible = true
                end
            end

            -- SHOP SKIP BUTTONS
            local buttons = shop:FindFirstChild("Buttons")
            local skips = buttons and buttons:FindFirstChild("Skips")

            show(skips, "Seasonal")
            show(skips, "Collab")
        end
    end

    pcall(update)

    task.spawn(function()
        while PlayerGui:GetAttribute("DoorsShopVisibilityVersion") == version do
            pcall(update)
            task.wait(1)
        end
    end)
end

