-- A-90 PLAYER ACTION: BETWEEN RANSOM AND ADMIN
-- Uses the LOCAL player's name (no fixed username).
-- The cloned visual button sends A90Player once per tap.
-- Does not change Items, Debug, or original actions.
-- =====================================
do
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local actionGroup = playersGroup:FindFirstChild("Player Actions")

    local function findActionButton(root, wanted)
        wanted = wanted:upper()
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                if obj.Text:upper():gsub("%s+", " ") == wanted then
                    local current = obj
                    while current and current ~= root do
                        if current:IsA("GuiButton") then
                            return current
                        end
                        current = current.Parent
                    end
                end
            end
        end
        return nil
    end

    if not actionGroup then
        warn("A-90: Player Actions section not found")
    else
        local ok, err = pcall(function()
            local ransom = findActionButton(actionGroup, "RANSOM")
            local adminButton = findActionButton(actionGroup, "ADMIN")
            if not ransom or not adminButton then
                error("Ransom/Admin buttons not found")
            end
            if ransom.Parent ~= adminButton.Parent then
                error("Ransom and Admin are in different GUI parents")
            end

            local targetParent = ransom.Parent
            local previous = targetParent:FindFirstChild("A90CustomButton")
            if previous then previous:Destroy() end

            -- Clone ONLY the appearance. Event connections on the
            -- original Ransom button are not copied by Clone().
            local addedButton = ransom:Clone()
            addedButton.Name = "A90CustomButton"
            addedButton.Visible = true
            addedButton.Active = true
            addedButton.AutoButtonColor = ransom.AutoButtonColor

            -- Prevent cloned LocalScripts from adding unrelated behavior.
            for _, descendant in ipairs(addedButton:GetDescendants()) do
                if descendant:IsA("LocalScript") or descendant:IsA("Script") then
                    descendant:Destroy()
                end
            end

            -- The cloned Ransom button already has the correct label
            -- color, font, outline, gradients and transparencies.
            -- Only change the label text; preserve all styling.
            local foundTitle = false
            if addedButton:IsA("TextButton") then
                addedButton.Text = "A-90"
                foundTitle = true
            end
            for _, descendant in ipairs(addedButton:GetDescendants()) do
                if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
                    if descendant.Text:upper():gsub("%s+", " ") == "RANSOM" then
                        descendant.Text = "A-90"
                        foundTitle = true
                    end
                end
            end
            if not foundTitle then
                warn("A-90: cloned label did not match Ransom; inspect button")
            end

            addedButton.Parent = targetParent

            -- Preserve the preexisting visual order, including buttons
            -- that share the same LayoutOrder. DO NOT alphabetize ties:
            -- doing that reordered all the other Player Actions.
            local layout = targetParent:FindFirstChildOfClass("UIListLayout")
                or targetParent:FindFirstChildOfClass("UIGridLayout")
            if layout then layout.SortOrder = Enum.SortOrder.LayoutOrder end

            local siblings = {}
            for originalIndex, gui in ipairs(targetParent:GetChildren()) do
                if gui:IsA("GuiObject") and gui ~= addedButton then
                    table.insert(siblings, {
                        object = gui,
                        order = gui.LayoutOrder,
                        x = gui.AbsolutePosition.X,
                        y = gui.AbsolutePosition.Y,
                        index = originalIndex
                    })
                end
            end
            table.sort(siblings, function(a, b)
                if a.order ~= b.order then return a.order < b.order end
                -- The existing UI may have tied LayoutOrder values;
                -- keep their actual on-screen order instead of sorting by name.
                if a.y ~= b.y then return a.y < b.y end
                if a.x ~= b.x then return a.x < b.x end
                return a.index < b.index
            end)

            -- Set a new sequence without changing the relative order
            -- of ANY existing action. Only insert A-90 after Ransom.
            local ordered = {}
            for _, entry in ipairs(siblings) do
                table.insert(ordered, entry.object)
                if entry.object == ransom then
                    table.insert(ordered, addedButton)
                end
            end
            for index, gui in ipairs(ordered) do
                gui.LayoutOrder = index
            end

            -- Resolve the RemoteEvent once; no username is hard-coded.
            local remotes = ReplicatedStorage:WaitForChild("RemotesFolder", 15)
            local remote = remotes and remotes:WaitForChild("AdminPanelRunCommand", 15)
            if not remote or not remote:IsA("RemoteEvent") then
                warn("A-90: AdminPanelRunCommand RemoteEvent not found")
            else
                local function triggerA90()
                    -- Current executor player, regardless of username.
                    local username = Players.LocalPlayer.Name
                    remote:FireServer("A90Player", {
                        Players = {
                            [username] = username
                        }
                    })
                    print("A-90 request sent for:", username)
                end

                -- Bind directly to the copied button, allowing each click
                -- to send a new request; there is no local cooldown.
                addedButton.Activated:Connect(triggerA90)
                print("A-90 button installed between Ransom and Admin")
            end
        end)
        if not ok then warn("A-90 setup failed:", err) end
    end
end

