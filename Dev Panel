-- Independent visibility worker: starts before admin initialization.
do
    local version = (pg:GetAttribute("DoorsShopVisibilityVersion") or 0) + 1
    pg:SetAttribute("DoorsShopVisibilityVersion", version)
    local function show(parent, name)
        local obj = parent and parent:FindFirstChild(name)
        if obj and obj:IsA("GuiObject") then obj.Visible = true end
        return obj
    end
    local function update()
        local topUI = pg:FindFirstChild("TopbarUI")
        local top = topUI and topUI:FindFirstChild("Topbar")
        for _, name in ipairs({"EventCoins", "Gold", "Boosts"}) do show(top, name) end
        local global = pg:FindFirstChild("GlobalUI")
        local shop = global and global:FindFirstChild("Shop")
        local scroll = shop and shop:FindFirstChild("ScrollingShop")
        if not scroll then return end
        for _, name in ipairs({"Collab", "Promo", "Seasonal", "SeasonalChrimah]", "_TrickOrTreatSeasonal", "AdminPanel", "GiftAdminPanel"}) do
            show(scroll, name)
        end
        local knobs = scroll:FindFirstChild("Knobs")
        show(knobs, "7")
        show(knobs, "8")
        for _, obj in ipairs(scroll:GetDescendants()) do
            if (obj.Name == "FinalReward" or obj.Name == "FinalRewardOut" or obj.Name == "WPromo") and obj:IsA("GuiObject") then
                obj.Visible = true
            end
        end
        local buttons = shop:FindFirstChild("Buttons")
        local skips = buttons and buttons:FindFirstChild("Skips")
        show(skips, "Seasonal")
        show(skips, "Collab")
    end
    pcall(update)
    task.spawn(function()
        while pg:GetAttribute("DoorsShopVisibilityVersion") == version do
            pcall(update)
            task.wait(1)
        end
    end)
end

