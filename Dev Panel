-- SALVAGE SELECTION COLORS
-- Unchecked: black (0,0,0)
-- Checked: dark gray (32,32,32)
-- Only affects SALVAGE item cards.
-- =====================================
do
    local salvageContents = section("SALVAGE")
    if salvageContents then
        local black = Color3.fromRGB(0, 0, 0)
        local checkedGray = Color3.fromRGB(32, 32, 32)

        local function setCardColor(card, selected)
            local tint = selected and checkedGray or black
            -- Apply to the item background, not to its icon or text.
            card.BackgroundColor3 = tint
            local holder = card:FindFirstChild("Container")
            if holder and holder:IsA("GuiObject") then
                holder.BackgroundColor3 = tint
            end
        end

        for _, card in ipairs(salvageContents:GetChildren()) do
            if card:IsA("GuiButton") then
                local marked = card:FindFirstChild("IsSelected", true)
                local selected = marked and marked:IsA("GuiObject")
                    and marked.Visible or false

                setCardColor(card, selected)

                -- Use the game's checkmark visibility when available.
                if marked and marked:IsA("GuiObject") then
                    marked:GetPropertyChangedSignal("Visible"):Connect(function()
                        selected = marked.Visible
                        setCardColor(card, selected)
                    end)
                end

                -- Fallback for versions that don't update IsSelected.Visible.
                card.Activated:Connect(function()
                    local previousMarker = marked and marked:IsA("GuiObject")
                        and marked.Visible or nil
                    task.defer(function()
                        if marked and marked:IsA("GuiObject")
                            and marked.Visible ~= previousMarker then
                            selected = marked.Visible
                        else
                            selected = not selected
                        end
                        setCardColor(card, selected)
                    end)
                end)
            end
        end
    end
end

