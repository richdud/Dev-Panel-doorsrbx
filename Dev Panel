local function section(name) return newItems:FindFirstChild(name .. "Contents", true) end
local function getIcon(card)
    local holder = card and card:FindFirstChild("Container")
    return holder and holder:FindFirstChild("Icon")
end
local function getLabel(card)
    local holder = card and card:FindFirstChild("Container")
    return holder and holder:FindFirstChild("SubTitle")
end
local function updateImage(card, id)
    local icon, image = getIcon(card), images[id]
    if icon and image and (icon:IsA("ImageLabel") or icon:IsA("ImageButton")) then
        icon.Image = image
        icon.ImageColor3 = Color3.new(1,1,1)
        icon.ImageTransparency = 0
        icon.Visible = true
    end
end
for _, name in ipairs(categoryOrder) do
    local contents, entries = section(name), data[name]
    if contents and entries then
        local layout = contents:FindFirstChildOfClass("UIGridLayout") or contents:FindFirstChildOfClass("UIListLayout")
        if layout then layout.SortOrder = Enum.SortOrder.LayoutOrder end
        for index, entry in ipairs(entries) do
            local id, display = entry[1], entry[2]
            local card = contents:FindFirstChild(id)
            if card then
                card.LayoutOrder = index
                card.Visible = true
                updateImage(card, id)
                local label = getLabel(card)
                if label then
                    label.Text = display
                    if name == "SALVAGE" then label.TextColor3 = Color3.new(1,1,1) end
                end
            end
        end
        local listed = {}
        for _, entry in ipairs(entries) do listed[entry[1]] = true end
        if name == "UTILITY" then
            local finalIDs = {"ObjectScanner", "Briefcase", "PaperPlane", "Leftovers", "HoneyPot", "Microwave"}
            local otherCards = {}
            for _, card in ipairs(contents:GetChildren()) do
                if card:IsA("GuiButton") and not table.find(finalIDs, card.Name) and not listed[card.Name] then
                    table.insert(otherCards, card)
                end
            end
            table.sort(otherCards, function(a,b) return a.LayoutOrder < b.LayoutOrder end)
            local position = 0
            for _, entry in ipairs(entries) do
                if not table.find(finalIDs, entry[1]) then
                    local card = contents:FindFirstChild(entry[1])
                    if card then position += 1; card.LayoutOrder = position end
                end
            end
            for _, card in ipairs(otherCards) do position += 1; card.LayoutOrder = position end
            for _, id in ipairs(finalIDs) do
                local card = contents:FindFirstChild(id)
                if card then position += 1; card.LayoutOrder = position; updateImage(card, id) end
            end
        else
            local extras = {}
            for _, card in ipairs(contents:GetChildren()) do
                if card:IsA("GuiButton") and not listed[card.Name] then table.insert(extras, card) end
            end
            table.sort(extras, function(a,b) return a.LayoutOrder < b.LayoutOrder end)
            for index, card in ipairs(extras) do card.LayoutOrder = #entries + index end
        end
    end
end
