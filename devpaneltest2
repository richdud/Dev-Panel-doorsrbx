-- THIRD PERSON TOGGLE LOGIC
-- ==========================================
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer or Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
local BIND = "DoorsThirdPersonToggle"
local DISTANCE = 10 -- Distance behind player

local function unbindAll()
    pcall(RunService.UnbindFromRenderStep, RunService, BIND)
    if _G.__tpCharConn then
        pcall(function() _G.__tpCharConn:Disconnect() end)
        _G.__tpCharConn = nil
    end
end

-- Check if already on, turn OFF
if _G.__tpOn then
    _G.__tpOn = false
    unbindAll()
    LocalPlayer.CameraMinZoomDistance = 0.5
    LocalPlayer.CameraMaxZoomDistance = 0.5
    LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
    print("[Camera] First Person")
else
    -- Turn ON
    _G.__tpOn = true
    unbindAll()

    LocalPlayer.CameraMode = Enum.CameraMode.Classic
    LocalPlayer.CameraMinZoomDistance = 0.5
    LocalPlayer.CameraMaxZoomDistance = 128

    -- Survive respawns
    _G.__tpCharConn = LocalPlayer.CharacterAdded:Connect(function()
        if not _G.__tpOn then return end
        task.wait(0.3)
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.CameraMaxZoomDistance = 128
    end)

    local acc = 0
    RunService:BindToRenderStep(BIND, Enum.RenderPriority.Camera.Value + 1, function(dt)
        local cam = workspace.CurrentCamera
        if not cam then return end

        -- Reassert properties Doors keeps resetting
        acc += dt
        if acc >= 0.5 then
            acc = 0
            if LocalPlayer.CameraMode ~= Enum.CameraMode.Classic then
                LocalPlayer.CameraMode = Enum.CameraMode.Classic
            end
            if LocalPlayer.CameraMaxZoomDistance < 50 then
                LocalPlayer.CameraMaxZoomDistance = 128
            end
        end

        cam.CFrame = cam.CFrame * CFrame.new(0, 0, DISTANCE)
    end)
    print("[Camera] Third Person")
end

