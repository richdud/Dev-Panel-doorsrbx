-- Checks if any UI Override from the config list is currently active
local function getActiveOverride()
  local behindUI = LocalPlayer.PlayerGui:FindFirstChild("BehindUI")
  if behindUI then
    for frameName, overrideData in pairs(STATIC_OVERRIDES) do
      if behindUI:FindFirstChild(frameName) then
        return overrideData
      end
    end
  end
  return nil
end

local function makeStarRed(starInstance)
  if starInstance:IsA("BasePart") then
    starInstance.Color = Color3.fromRGB(255, 0, 0)
  end
  for _, desc in pairs(starInstance:GetDescendants()) do
    if desc:IsA("BasePart") then
      desc.Color = Color3.fromRGB(255, 0, 0)
    end
  end
end

local function getInstanceCFrame(instance)
  if instance:IsA("BasePart") then
    return instance.CFrame
  elseif instance:IsA("Model") then
    local primary = instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart")
    return primary and primary.CFrame or instance:GetPivot()
  end
  return nil
end

local function turnOnScanner()
  screenUI.OffScreen.Visible = false
  screenUI.Static1.ImageTransparency = 0
  screenUI.Static2.ImageTransparency = 1
  screenUI.ViewSpecial.ImageColor3 = Color3.fromRGB(255, 255, 255)

  if not isSurgeActive and not getActiveOverride() then
    TweenService:Create(screenUI.Static1, TweenInfo.new(3, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {
      ImageTransparency = 0.975,
    }):Play()
  end

  TweenService:Create(screenUI.ViewSpecial, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut, 0, true), {
    ImageColor3 = Color3.fromRGB(49, 93, 52),
  }):Play()

  viewportCamera.FieldOfView = 1
  TweenService:Create(viewportCamera, TweenInfo.new(3, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {
    FieldOfView = 30,
  }):Play()

  handle.Use:Play()
  handle.Idle:Play()
end

local function turnOffScanner()
  screenUI.OffScreen.Visible = true
  screenUI.OffScreen.BackgroundTransparency = 0
  screenUI.OffScreen.BackgroundColor3 = Color3.fromRGB(39, 59, 33)

  TweenService:Create(screenUI.OffScreen, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0, false), {
    BackgroundColor3 = Color3.fromRGB(0, 0, 0),
  }):Play()

  screenUI.OffScreen.Frame.Size = UDim2.new(1, 0, 1, 0)
  TweenService:Create(screenUI.OffScreen.Frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
    Size = UDim2.new(1, 0, 0.05, 0),
  }):Play()

  task.delay(0.2, function()
    TweenService:Create(screenUI.OffScreen.Frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
      Size = UDim2.new(0, 0, 0, 0),
    }):Play()
  end)

  handle.Disable:Play()
  if animationTracks.idle then
    animationTracks.idle:Stop()
  end
end

