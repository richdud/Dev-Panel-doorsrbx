-- Creates a dynamic character clone that syncs at 18 FPS
local function createViewportCharacter(character)
  local cloneModel = Instance.new("Model")
  cloneModel.Name = character.Name
  local partsMap = {}

  local function addPart(part)
    if part:IsA("BasePart") or part:IsA("MeshPart") then
      local pClone = part:Clone()
      pClone:ClearAllChildren()
      for _, child in pairs(part:GetChildren()) do
        if child:IsA("DataModelMesh") or child:IsA("Decal") then
          child:Clone().Parent = pClone
        end
      end
      pClone.Anchored = true
      pClone.CanCollide = false
      pClone.CanQuery = false
      pClone.Parent = cloneModel
      partsMap[part] = pClone
    end
  end

  for _, desc in pairs(character:GetDescendants()) do
    addPart(desc)
  end

  local addConn = character.DescendantAdded:Connect(addPart)
  local remConn = character.DescendantRemoving:Connect(function(desc)
    if partsMap[desc] then
      partsMap[desc]:Destroy()
      partsMap[desc] = nil
    end
  end)

  cloneModel.AncestryChanged:Connect(function()
    if not cloneModel.Parent then
      addConn:Disconnect()
      remConn:Disconnect()
    end
  end)

  return cloneModel, partsMap
end

local function registerMarker(descendant)
  if activeEntities[descendant] or allStars[descendant] then return end

  local isSpecial = table.find(SPECIAL_ITEM_NAMES, descendant.Name) ~= nil
  local isEntity = table.find(ENTITY_NAMES, descendant.Name) ~= nil

  if not (isSpecial or isEntity) then return end

  local initialCFrame = getInstanceCFrame(descendant)
  if not initialCFrame then return end

  local star = storage.Star:Clone()
  star.CFrame = initialCFrame

  if isEntity then
    makeStarRed(star)
    activeEntities[descendant] = star
  end

  star.Parent = screenUI.ViewSpecial
  allStars[descendant] = star

  local cleanupConnection
  cleanupConnection = descendant.AncestryChanged:Connect(function(_, parent)
    if not parent or not descendant:IsDescendantOf(workspace) then
      activeEntities[descendant] = nil
      allStars[descendant] = nil
      star:Destroy()
      if cleanupConnection then
        cleanupConnection:Disconnect()
      end
    end
  end)
end

local function cloneRoomIntoViewport(roomModel)
  if screenUI.ViewNormal:FindFirstChild(roomModel.Name) then return end

  local clonedRoom = Instance.new("Model", screenUI.ViewNormal)
  clonedRoom.Name = roomModel.Name

  local function cloneDescendant(descendant)
    if descendant:IsDescendantOf(screenUI) then return end
    if descendant:IsA("BasePart") and descendant.Transparency ~= 1 and descendant.Size.Magnitude > 0.2 then
      local clone = descendant:Clone()
      clone.CanQuery = false
      clone.Parent = clonedRoom

      if not descendant.Anchored then
        task.spawn(function()
          while task.wait(1) do
            if not descendant or not descendant.Parent then break end
            clone.CFrame = descendant.CFrame
          end
          clone:Destroy()
        end)
      end
    end
    registerMarker(descendant)
  end

  for _, descendant in pairs(roomModel:GetDescendants()) do cloneDescendant(descendant) end
  local descendantConnection = roomModel.DescendantAdded:Connect(cloneDescendant)
  clonedRoom.AncestryChanged:Connect(function()
    if not clonedRoom.Parent then descendantConnection:Disconnect() end
  end)
end

local function reloadRoomSeamlessly(roomModel)
  task.delay(RELOAD_DELAY, function()
    if not roomModel or not roomModel.Parent then return end

    for inst, star in pairs(allStars) do
      local isOrphaned = not inst or not inst.Parent or not inst:IsDescendantOf(workspace)
      local isInReloadingRoom = inst and typeof(inst) == "Instance" and inst:IsDescendantOf(roomModel)

      if isOrphaned or isInReloadingRoom then
        if activeEntities[inst] then activeEntities[inst] = nil end
        allStars[inst] = nil
        if star then star:Destroy() end
      end
    end

    local tempRoom = Instance.new("Model")
    tempRoom.Name = roomModel.Name .. "_TempReload"

    for _, descendant in pairs(roomModel:GetDescendants()) do
      if not descendant:IsDescendantOf(screenUI) then
        if descendant:IsA("BasePart") and descendant.Transparency ~= 1 and descendant.Size.Magnitude > 0.2 then
          local clone = descendant:Clone()
          clone.CanQuery = false
          clone.Parent = tempRoom

          if not descendant.Anchored then
            task.spawn(function()
              while task.wait(1) do
                if not descendant or not descendant.Parent then break end
                clone.CFrame = descendant.CFrame
              end
              clone:Destroy()
            end)
          end
        end
        registerMarker(descendant)
      end
    end

    -- Re-scan LiveEntities folder during room reload
    local liveEntitiesFolder = workspace:FindFirstChild("LiveEntities")
    if liveEntitiesFolder then
      for _, descendant in pairs(liveEntitiesFolder:GetDescendants()) do
        registerMarker(descendant)
      end
    end

    local oldRoom = screenUI.ViewNormal:FindFirstChild(roomModel.Name)
    tempRoom.Name = roomModel.Name
    tempRoom.Parent = screenUI.ViewNormal
    if oldRoom then oldRoom:Destroy() end
  end)
end

local function removeRoomFromViewport(roomName)
  local clonedRoom = screenUI.ViewNormal:FindFirstChild(roomName)
  if clonedRoom then clonedRoom:Destroy() end
end

local function syncAllRooms()
  local currentRoomsFolder = workspace:FindFirstChild("CurrentRooms")
  if currentRoomsFolder then
    for _, room in pairs(currentRoomsFolder:GetChildren()) do cloneRoomIntoViewport(room) end
  end

  -- Explicit scan for workspace.LiveEntities
  local liveEntitiesFolder = workspace:FindFirstChild("LiveEntities")
  if liveEntitiesFolder then
    for _, descendant in pairs(liveEntitiesFolder:GetDescendants()) do
      registerMarker(descendant)
    end
  end
end

