  if not held or held ~= scannerTool then return end

  if input.KeyCode ~= Enum.KeyCode.X
    and input.KeyCode ~= Enum.KeyCode.Backspace
    and input.KeyCode ~= Enum.KeyCode.DPadDown then
    return
  end

  DropScanner(held)
end)

