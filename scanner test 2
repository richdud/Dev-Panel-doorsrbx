  for _, anim in pairs(scannerTool:WaitForChild("Animations"):GetChildren()) do
    animationTracks[anim.Name] = LocalPlayer.Character.Humanoid:LoadAnimation(anim)
  end
  animationTracks.equip:Play()
  animationTracks.idle:Play()

  screenUI.Parent = LocalPlayer.PlayerGui
  screenUI.Enabled = true
  screenUI.Adornee = scannerTool:WaitForChild("Handle"):WaitForChild("Screen")

  syncAllRooms()
  local roomName = LocalPlayer:GetAttribute("CurrentRoom")
  currentRoomId = roomName

  isEquipped = true
  isScannerOn = true
  turnOnScanner()

  while isEquipped do
    if isScannerOn then
      local success, err = pcall(function()
        roomName = LocalPlayer:GetAttribute("CurrentRoom")

        if not DISABLE_STATIC then
          viewportCamera.CFrame = scannerTool.Handle.Screen.CFrame * CFrame.Angles(0, 3.15, 0)
          screenUI.ViewNormal.LightDirection = viewportCamera.CFrame.LookVector - Vector3.new(0, -1, 0)
          randomizeStatic()

          local activeOverride = getActiveOverride()

          if activeOverride then
            screenUI.Static1.ImageColor3 = activeOverride.Color
            screenUI.Static2.ImageColor3 = activeOverride.Color
            screenUI.Static1.ImageTransparency = 0

            if activeOverride.CenterImage then
              overrideCenterImage.Image = activeOverride.CenterImage
              overrideCenterImage.Visible = true
            else
              overrideCenterImage.Visible = false
            end
            wasOverrideActive = true
          else
            screenUI.Static1.ImageColor3 = Color3.fromRGB(255, 255, 255)
            screenUI.Static2.ImageColor3 = Color3.fromRGB(255, 255, 255)
            overrideCenterImage.Visible = false

            if isSurgeActive then
              screenUI.Static1.ImageTransparency = 0
              wasSurgeActive = true
            else
              if wasSurgeActive or wasOverrideActive then
                wasSurgeActive = false
                wasOverrideActive = false
                TweenService:Create(screenUI.Static1, TweenInfo.new(3, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {
                  ImageTransparency = 0.975,
                }):Play()
              end
            end
          end
        else
          if screenUI.Static1.Visible then
            screenUI.Static1.Visible = false
            screenUI.Static2.Visible = false
          end
        end

        for _, star in pairs(screenUI.ViewSpecial:GetChildren()) do
          if star:IsA("Model") or star:IsA("BasePart") then
            local starPos = star:IsA("Model") and (star.PrimaryPart and star.PrimaryPart.Position or star:GetPivot().Position) or star.Position
            if star:IsA("Model") then
              star:PivotTo(CFrame.new(starPos, viewportCamera.CFrame.Position))
            else
              star.CFrame = CFrame.new(starPos, viewportCamera.CFrame.Position)
            end
          end
        end

        if roomName ~= currentRoomId then
          currentRoomId = roomName
          local currentRoomModel = currentRoomsFolder:FindFirstChild(roomName)
          if currentRoomModel then
            reloadRoomSeamlessly(currentRoomModel)
          end
        end
      end)
      if not success then warn(err) end
    end
    if not isEquipped then break end
    task.wait(frameInterval)
  end
end)

-- ===== UNEQUIPPED =====
scannerTool.Unequipped:Connect(function()
  screenUI.Parent = script
  screenUI.Enabled = false
  for _, child in pairs(handle:GetChildren()) do
    if child:IsA("Sound") then child:Stop() end
  end
  handle.Disable:Play()
  if animationTracks.equip then animationTracks.equip:Stop() end
  if animationTracks.idle then animationTracks.idle:Stop() end
  isEquipped = false
end)
