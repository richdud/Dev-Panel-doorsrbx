-- DEDICATED 18 FPS THREAD: Entities, Player Replication, and Third-Person Fake Scanners
task.spawn(function()
  while true do
    if isScannerOn and isEquipped then
      -- 1. Sync Entity Stars
      for entity, star in pairs(activeEntities) do
        if entity and entity.Parent and star and star.Parent then
          local cf = getInstanceCFrame(entity)
          if cf then
            star.CFrame = CFrame.new(cf.Position, viewportCamera.CFrame.Position)
          end
        else
          if star then star:Destroy() end
          activeEntities[entity] = nil
        end
      end

      -- 2. Process all other players (Fake Scanners & Viewport Clones)
      for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
          local char = player.Character
          local humanoid = char:FindFirstChildOfClass("Humanoid")
          local isPlayingScannerAnim = false

          if humanoid and humanoid:FindFirstChildOfClass("Animator") then
            for _, track in pairs(humanoid.Animator:GetPlayingAnimationTracks()) do
              if scannerAnimIds[track.Animation.AnimationId] then
                isPlayingScannerAnim = true
                break
              end
            end
          end

          -- Handle Fake Scanner attachment with fixed hand alignment
          local existingScanner = char:FindFirstChild("FakeNVCS3000")
          if isPlayingScannerAnim then
            if not existingScanner then
              local fakeScanner = fakeScannerTemplate:Clone()
              local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
              if rightHand and fakeScanner:FindFirstChild("Handle") then
                fakeScanner.Handle.CFrame = rightHand.CFrame * CFrame.new(0, -0.6, -0.4) * CFrame.Angles(math.rad(-90), 0, 0)
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = rightHand
                weld.Part1 = fakeScanner.Handle
                weld.Parent = fakeScanner.Handle
                fakeScanner.Parent = char
              else
                fakeScanner:Destroy()
              end
            end
          else
            if existingScanner then existingScanner:Destroy() end
          end

          -- Handle Viewport Player Rendering Sync
          if not activePlayerClones[char] then
            local cloneModel, pMap = createViewportCharacter(char)
            cloneModel.Parent = screenUI.ViewNormal
            activePlayerClones[char] = { model = cloneModel, partsMap = pMap }
          end

          for realPart, clonePart in pairs(activePlayerClones[char].partsMap) do
            if realPart and realPart.Parent and clonePart then
              clonePart.CFrame = realPart.CFrame
            end
          end
        end
      end

      -- 3. Cleanup Dead/Removed Player Clones
      for char, cloneData in pairs(activePlayerClones) do
        if not char or not char.Parent then
          if cloneData.model then cloneData.model:Destroy() end
          activePlayerClones[char] = nil
        end
      end
    end
    task.wait(entityFrameInterval)
  end
end)

