-- Helper to create pages
local v5 = nil
local function CreatePage(p1, p2)
    local v12 = script.Page:Clone()
    v12.Name = p1
    v12.Visible = false
    v12.Parent = v1.Container.Pages
    v12.UIListLayout:AddTag("AdminPanelFixPadding")
    
    local v3 = setmetatable({
        Scrolling = v12,
        Elements = {}
    }, {})
    v3.__index = v3
    
    function v3:Show()
        for v1, v2 in self.Elements do
            v2.LayoutOrder = v1
            v2.Parent = self.Scrolling
        end
        self.Scrolling.Visible = true
    end
    
    function v3:Hide()
        for v1, v2 in self.Elements do
            v2.Parent = nil
        end
        self.Scrolling.Visible = false
    end
    
    local v4 = script.TabButton:Clone()
    v4.Button.Icon.Image = p2
    v4.Button.Title.Text = p1
    v4.Button.Activated:Connect(function()
        if v5 then v5:Hide() end
        v5 = v3
        v3:Show()
    end)
    v4.Parent = v1.Container.TabButtons
    if #v1.Container.Pages:GetChildren() == 1 then
        v5 = v3
        v3:Show()
    end
    return v3
end

