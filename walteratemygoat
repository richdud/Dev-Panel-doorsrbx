-- Function to Drop Honcho
local function dropHoncho()
    local player = LocalPlayer
    local character = player.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    -- Clone the Honcho Model
    local honchoModel = game:GetObjects("rbxassetid://" .. HONCHO_MODEL_ID)[1]
    if not honchoModel then 
        warn("Failed to load Honcho Model") 
        return 
    end
    
    honchoModel.Name = "Honcho_Dropped"
    honchoModel.Parent = workspace
    
    -- Position it in front of the player
    local offset = CFrame.new(0, 0, -3) * CFrame.Angles(0, math.rad(180), 0)
    honchoModel:PivotTo(rootPart.CFrame * offset)
    
    -- Play Drop Sound
    local dropSound = Instance.new("Sound")
    dropSound.SoundId = "rbxassetid://" .. HONCHO_DROP_SOUND
    dropSound.Parent = honchoModel
    dropSound:Play()
    
    -- Make it fall
    for _, part in ipairs(honchoModel:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.CanCollide = true
        end
    end
    
    print("Honcho Dropped!")
end

