-- GRUMBLE
local function transformIntoGrumble()
    if _G.TransformedIntoAnyMorph == true then return end
    _G.TransformedIntoAnyMorph = true
    local success, result = pcall(function()
        return game:GetObjects("rbxassetid://72896977745894")
    end)
    if not success or not result or not result[1] then
        warn("Grumble: Failed to load asset 72896977745894.")
        _G.TransformedIntoAnyMorph = false
        return
    end
    local grumble = trackMorphModel(result[1])
    if not grumble:IsA("Model") then
        warn("Grumble asset is not a Model.")
        grumble:Destroy()
        _G.TransformedIntoAnyMorph = false
        return
    end
    grumble.Parent = workspace
    pcall(function()
        grumble:ScaleTo(0.3)
    end)
    
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or not root then
        warn("Grumble: Your character is not ready.")
        resetMorph()
        return
    end
    
    local controller = grumble:FindFirstChildWhichIsA("AnimationController", true)
    local grumbleHumanoid = grumble:FindFirstChildWhichIsA("Humanoid", true)
    local animator
    if controller then
        animator = controller:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = controller
        end
    elseif grumbleHumanoid then
        animator = grumbleHumanoid:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = grumbleHumanoid
        end
    end
    if not animator then
        warn("Grumble: No AnimationController/Humanoid was found in the asset.")
        resetMorph()
        return
    end
    
    local function loadGrumbleTrack(animationId, name, priority)
        local animation = Instance.new("Animation")
        animation.Name = name
        animation.AnimationId = "rbxassetid://" .. animationId
        animation.Parent = grumble
        local ok, track = pcall(function()
            return animator:LoadAnimation(animation)
        end)
        if not ok or not track then
            animation:Destroy()
            warn("Grumble: Could not load " .. name)
            return nil
        end
        track.Looped = true
        track.Priority = priority
        return track
    end
    
    local crawlTrack = loadGrumbleTrack("18687934629", "GrumbleCrawl", Enum.AnimationPriority.Movement)
    if not crawlTrack then
        resetMorph()
        return
    end
    local blinkTrack = loadGrumbleTrack("18967355407", "GrumbleBlink", Enum.AnimationPriority.Action)
    
    local function setMoving(shouldMove, speed)
        if not grumble.Parent then return end
        if not crawlTrack.IsPlaying then
            crawlTrack:Play(0.25)
        end
        if shouldMove then
            crawlTrack:AdjustSpeed(math.clamp((speed or 8) / 8, 0.7, 1.9))
        else
            crawlTrack:AdjustSpeed(0.12)
        end
    end
    
    crawlTrack:Play(0)
    crawlTrack:AdjustSpeed(0.12)
    if blinkTrack then
        blinkTrack:Play(0.3)
    end
    
    local renderConnection
    renderConnection = RunService.RenderStepped:Connect(function()
        if not grumble.Parent or not _G.TransformedIntoAnyMorph then
            renderConnection:Disconnect()
            return
        end
        character = LocalPlayer.Character
        root = character and character:FindFirstChild("HumanoidRootPart")
        if root then
            grumble:PivotTo(root.CFrame)
        end
        hideCharacterLocally(LocalPlayer.Character)
    end)
    
    local runningConnection
    runningConnection = humanoid.Running:Connect(function(speed)
        if not grumble.Parent or not _G.TransformedIntoAnyMorph then
            runningConnection:Disconnect()
            return
        end
        setMoving(speed >= 1, speed)
    end)
end

-- GROUNDSKEEPER
local function transformIntoGroundskeeper()
    if _G.TransformedIntoAnyMorph == true then return end
    _G.TransformedIntoAnyMorph = true
    local success, result = pcall(function()
        return game:GetObjects("rbxassetid://105352265307130")
    end)
    if not success or not result or not result[1] then
        warn("Groundskeeper: Failed to load asset 105352265307130")
        _G.TransformedIntoAnyMorph = false
        return
    end
    local groundskeeper = trackMorphModel(result[1])
    if not groundskeeper:IsA("Model") then
        warn("Groundskeeper asset is not a Model")
        groundskeeper:Destroy()
        _G.TransformedIntoAnyMorph = false
        return
    end
    groundskeeper.Parent = workspace
    pcall(function()
        groundskeeper:ScaleTo(0.85)
    end)
    
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or not root then
        warn("Groundskeeper: Character not ready")
        resetMorph()
        return
    end
    
    local controller = groundskeeper:FindFirstChildWhichIsA("AnimationController", true)
    local gkHumanoid = groundskeeper:FindFirstChildWhichIsA("Humanoid", true)
    local animator
    if controller then
        animator = controller:FindFirstChildOfClass("Animator") or Instance.new("Animator", controller)
    elseif gkHumanoid then
        animator = gkHumanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", gkHumanoid)
    end
    if not animator then
        warn("Groundskeeper: No Animator found")
        resetMorph()
        return
    end
    
    local function loadTrack(anim, priority)
        local ok, track = pcall(function()
            return animator:LoadAnimation(anim)
        end)
        if ok and track then
            track.Looped = true
            track.Priority = priority or Enum.AnimationPriority.Movement
            return track
        end
        return nil
    end
    
    local idleTrack, walkTrack
    for _, item in ipairs(groundskeeper:GetDescendants()) do
        if item:IsA("Animation") then
            local name = string.lower(item.Name)
            if (name:find("idle") or name:find("stand")) and not idleTrack then
                idleTrack = loadTrack(item, Enum.AnimationPriority.Idle)
            elseif (name:find("walk") or name:find("run") or name:find("move")) and not walkTrack then
                walkTrack = loadTrack(item, Enum.AnimationPriority.Movement)
            end
        end
    end
    
    playAllSoundsInModel(groundskeeper)
    
    local function setMoving(shouldMove, speed)
        if not groundskeeper.Parent then return end
        if shouldMove then
            if idleTrack and idleTrack.IsPlaying then idleTrack:Stop(0.25) end
            if walkTrack then
                if not walkTrack.IsPlaying then walkTrack:Play(0.25) end
                walkTrack:AdjustSpeed(math.clamp((speed or 8) / 10, 0.7, 1.6))
            end
        else
            if walkTrack and walkTrack.IsPlaying then walkTrack:Stop(0.25) end
            if idleTrack and not idleTrack.IsPlaying then
                idleTrack:Play(0.25)
            end
        end
    end
    
    if idleTrack then
        idleTrack:Play(0.3)
    elseif walkTrack then
        walkTrack:Play(0)
        walkTrack:AdjustSpeed(0.1)
    end
    
    local renderConnection
    renderConnection = RunService.RenderStepped:Connect(function()
        if not groundskeeper.Parent or not _G.TransformedIntoAnyMorph then
            renderConnection:Disconnect()
            return
        end
        character = LocalPlayer.Character
        root = character and character:FindFirstChild("HumanoidRootPart")
        if root then
            groundskeeper:PivotTo(root.CFrame * CFrame.new(0, 2.4, 0))
        end
        hideCharacterLocally(LocalPlayer.Character)
    end)
    
    local runningConnection
    runningConnection = humanoid.Running:Connect(function(speed)
        if not groundskeeper.Parent or not _G.TransformedIntoAnyMorph then
            runningConnection:Disconnect()
            return
        end
        setMoving(speed >= 1, speed)
    end)
end

