}

-- Handle Local Input
LocalPlayer:GetMouse().KeyDown:Connect(function(key)
    if key == "r" then
        -- If we are already transformed, try to cycle or just trigger the current one
        -- For simplicity, let's assume 'R' triggers the last used morph or a default
        -- Here we will just trigger Figure for demo, but you can expand this
        if not _G.TransformedIntoAnyMorph then
            transformIntoFigure()
            -- Send to server
            MorphEvent:FireServer("Figure")
        else
            -- Optional: Reset on R if already transformed? 
            -- Or cycle through morphs. Let's just reset for now if pressed again
            resetMorph()
            MorphEvent:FireServer("Reset")
        end
    end
end)

-- Listen for other players transforming
MorphEvent.OnClientEvent:Connect(function(playerName, morphType)
    if playerName == LocalPlayer.Name then return end
    
    -- Find the player object
    local targetPlayer = Players:FindFirstChild(playerName)
    if not targetPlayer then return end
    
    local targetChar = targetPlayer.Character
    if not targetChar then return end
    
    -- Spawn the morph for the OTHER player
    if morphType == "Reset" then
        -- Remove their morph
        local morphModel = targetChar:FindFirstChild("MorphModel_" .. playerName)
        if morphModel then
            morphModel:Destroy()
        end
        return
    end
    
    local func = morphFunctions[morphType]
    if func then
        -- We need to run the morph logic but target the other player
        -- This is tricky because the original functions target LocalPlayer
        -- So we clone the model and pivot it to the other player
        
        local morphModel = nil
        
        if morphType == "Figure" then
            morphModel = trackMorphModel(game:GetObjects("rbxassetid://116871580020558")[1])
        elseif morphType == "Gloombat" then
            morphModel = trackMorphModel(game:GetObjects("rbxassetid://72951473062980")[1])
        elseif morphType == "Rush" then
            morphModel = trackMorphModel(game:GetObjects("rbxassetid://100327482330650")[1])
        elseif morphType == "Ambush" then
            morphModel = trackMorphModel(game:GetObjects("rbxassetid://98266611233960")[1])
        elseif morphType == "Seek" then
            morphModel = trackMorphModel(game:GetObjects("rbxassetid://86341229891935")[1])
        elseif morphType == "Grumble" then
            local success, result = pcall(function() return game:GetObjects("rbxassetid://72896977745894") end)
            if success and result and result[1] then
                morphModel = trackMorphModel(result[1])
            end
        elseif morphType == "Groundskeeper" then
            local success, result = pcall(function() return game:GetObjects("rbxassetid://105352265307130") end)
            if success and result and result[1] then
                morphModel = trackMorphModel(result[1])
            end
        elseif morphType == "Screech" then
            local success, result = pcall(function() return game:GetService("ReplicatedStorage").Entities.Screech:Clone() end)
            if success and result then
                morphModel = trackMorphModel(result)
            end
        elseif morphType == "Eyes" then
            morphModel = trackMorphModel(game:GetObjects("rbxassetid://12457741170")[1])
        elseif morphType == "Halt" then
            morphModel = trackMorphModel(game:GetObjects("rbxassetid://12457734969")[1])
        end
        
        if morphModel then
            morphModel.Name = "MorphModel_" .. playerName
            morphModel.Parent = workspace
            
            -- Pivot to the other player
            local renderConn = RunService.RenderStepped:Connect(function()
                if not morphModel.Parent then
                    renderConn:Disconnect()
                    return
                end
                local otherChar = targetPlayer.Character
                local otherRoot = otherChar and otherChar:FindFirstChild("HumanoidRootPart")
                if otherRoot then
                    morphModel:PivotTo(otherRoot.CFrame)
                end
            end)
            
            -- Hide the other player's character locally
            local hideConn = RunService.RenderStepped:Connect(function()
                if not morphModel.Parent then
                    hideConn:Disconnect()
                    return
                end
                hideCharacterLocally(targetChar)
            end)
        end
    end
end)

