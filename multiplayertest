-- List of available morphs
local morphFunctions = {
    ["Figure"] = transformIntoFigure,
    ["Gloombat"] = transformIntoGloombat,
    ["Rush"] = transformIntoRush,
    ["Ambush"] = transformIntoAmbush,
    ["Seek"] = transformIntoSeek,
