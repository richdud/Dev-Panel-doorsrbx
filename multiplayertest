-- SIMPLE MORPHS (Eyes, Halt, etc)
local function simpleMorph(tag, assetId, anchorName, offsetY, extra)
    if _G.TransformedIntoAnyMorph then return end
    _G.TransformedIntoAnyMorph = true
    local success, result = pcall(function()
        return game:GetObjects("rbxassetid://" .. assetId)[1]
    end)
    if not success or not result then
        warn(tag .. ": Failed to load asset " .. assetId)
        _G.TransformedIntoAnyMorph = false
        return
    end
    local morph = trackMorphModel(result)
    morph.Parent = workspace
    local mainPart = (anchorName and morph:FindFirstChild(anchorName))
    or morph.PrimaryPart
    or morph:FindFirstChildWhichIsA("BasePart", true)
    if mainPart and mainPart:IsA("BasePart") then
        mainPart.Anchored = true
        mainPart.CanCollide = false
    end
    if extra then extra(morph) end
    playAllSoundsInModel(morph)
    
    local renderConn
    renderConn = RunService.RenderStepped:Connect(function()
        if not morph.Parent or not _G.TransformedIntoAnyMorph then
            renderConn:Disconnect()
            return
        end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            morph:PivotTo(root.CFrame * CFrame.new(0, offsetY, 0))
        end
        hideCharacterLocally(char)
    end)
end

local function transformIntoEyes()
    simpleMorph("Eyes", "12457741170", "Core", 1)
end

local function transformIntoHalt()
