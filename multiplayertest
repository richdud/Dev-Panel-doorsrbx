-- FIGURE
local function transformIntoFigure()
    if _G.TransformedIntoAnyMorph then return end
    _G.TransformedIntoAnyMorph = true
    
    local figureNew = trackMorphModel(game:GetObjects("rbxassetid://116871580020558")[1])
    if not figureNew then
        _G.TransformedIntoAnyMorph = false
        return
    end
    
    local gigglesDed = Instance.new("Folder")
    gigglesDed.Name = "GigglesFake"
    gigglesDed.Parent = workspace
    
    local stompCooldown = false
    local footstepType = 0
    local footstepType2 = 0
    local canwalk = true
    
    figureNew.Parent = workspace
    local StompAnim, IdleAnim, WalkAnim, RunAnim
    local animFolder = (game.GameId == 6627207668) and figureNew.AnimsTest or figureNew.Anims
    StompAnim = figureNew.AnimationController.Animator:LoadAnimation(animFolder.Stomp)
    IdleAnim = figureNew.AnimationController.Animator:LoadAnimation(animFolder.Idle)
    WalkAnim = figureNew.AnimationController.Animator:LoadAnimation(animFolder.Walk)
    RunAnim = figureNew.AnimationController.Animator:LoadAnimation(animFolder.Run)
    
    IdleAnim:Play()
    
    WalkAnim:GetMarkerReachedSignal("Footstep"):Connect(function()
        if canwalk then
            if footstepType2 == 1 then
                footstepType2 = 0
                figureNew.LeftFoot.Footstep:Play()
                figureNew.LeftFoot.FootstepLow:Play()
            else
                footstepType2 = 1
                figureNew.RightFoot.Footstep:Play()
                figureNew.RightFoot.FootstepLow:Play()
            end
        end
    end)
    
    RunAnim:GetMarkerReachedSignal("Footstep"):Connect(function()
        if canwalk then
            if footstepType2 == 1 then
                footstepType2 = 0
                figureNew.LeftFoot.Footstep:Play()
                figureNew.LeftFoot.FootstepLow:Play()
            else
                footstepType2 = 1
                figureNew.RightFoot.Footstep:Play()
                figureNew.RightFoot.FootstepLow:Play()
            end
        end
    end)
    
    local runningConn
    runningConn = LocalPlayer.Character.Humanoid.Running:Connect(function(speed)
        if not figureNew.Parent then
            runningConn:Disconnect()
            return
        end
        if speed >= 20 then
            IdleAnim:Stop()
            WalkAnim:Stop()
            if not RunAnim.IsPlaying then
                RunAnim:Play()
                RunAnim:AdjustSpeed(1.5)
            end
        elseif speed >= 5 then
            IdleAnim:Stop()
            RunAnim:Stop()
            if not WalkAnim.IsPlaying then
                WalkAnim:Play()
            end
        else
            WalkAnim:Stop()
            RunAnim:Stop()
            if not IdleAnim.IsPlaying then
                IdleAnim:Play()
            end
        end
    end)
    
    local function footstepSound()
        if footstepType == 1 then
            footstepType = 0
            figureNew.LeftFoot.Footstep:Play()
            figureNew.LeftFoot.FootstepLow:Play()
        else
            footstepType = 1
            figureNew.RightFoot.Footstep:Play()
            figureNew.RightFoot.FootstepLow:Play()
        end
    end
    
    local function killTheCacaoBallButWhite(ahhball)
        if not ahhball or not _G.StompGigglesEnabled then return end
        local newBall = ahhball:Clone()
        ahhball:Destroy()
        newBall.Name = "StompedGiggle" .. LocalPlayer.Name
        newBall.Parent = gigglesDed
        newBall:SetAttribute("RealName", "StompedGiggle")
        newBall.Root.Sound_Laugh:Stop()
        task.wait(0.3)
        newBall.Root.Sound_Kill:Play()
        task.wait(0.6)
        for _, GiggleThing in pairs(newBall:GetDescendants()) do
            if GiggleThing:IsA("NoCollisionConstraint") or GiggleThing:IsA("BallSocketConstraint") then
                GiggleThing:Destroy()
            end
        end
        task.wait(5)
        for _, GigglePart in pairs(newBall:GetDescendants()) do
            if GigglePart:IsA("BasePart") then
                game:GetService("TweenService"):Create(GigglePart, TweenInfo.new(5, Enum.EasingStyle.Linear), {Transparency = 1}):Play()
            end
        end
        task.wait(6)
        newBall:Destroy()
    end
    
    local function getNearestWhileStomping()
        local nearest = 5
        local nearestGiggle = nil
        local giggles = workspace.GigglesFake:GetChildren()
        for _, Giggle in pairs(giggles) do
            if Giggle and Giggle:FindFirstChild("Root") then
                local dist = (figureNew:GetPivot().Position - Giggle.Root.Position).Magnitude
                if dist <= nearest then
                    nearest = dist
                    nearestGiggle = Giggle
                end
            end
        end
        if nearestGiggle then
            task.spawn(killTheCacaoBallButWhite, nearestGiggle)
        end
    end
    
    local function stompF()
        if stompCooldown then return end
        stompCooldown = true
        canwalk = false
        LocalPlayer.Character.HumanoidRootPart.Anchored = true
        StompAnim:Play()
        getNearestWhileStomping()
        StompAnim:GetMarkerReachedSignal("Stomp"):Connect(function()
            figureNew.RightFoot.FootstepLowLoud:Play()
        end)
        StompAnim:GetMarkerReachedSignal("Footstep"):Connect(footstepSound)
        StompAnim:GetMarkerReachedSignal("Roar"):Connect(function()
            figureNew.Head.Growl:Play()
        end)
        StompAnim.Ended:Wait()
        canwalk = true
        LocalPlayer.Character.HumanoidRootPart.Anchored = false
        stompCooldown = false
    end
    
    local giggles = {}
    local function addGiggle(giggle)
        table.insert(giggles, giggle)
    end
    local function checkIfIsAGiggleRagdoll(giggle)
        task.spawn(function()
            local tries = 0
            repeat
                task.wait()
                tries += 1
            until tries >= 20 or giggle:FindFirstChild("Root")
            if giggle:FindFirstChild("Root")
            and giggle.Root:FindFirstChild("Sound_Kill")
            and giggle.Root:FindFirstChild("Sound_Laugh")
            and giggle:FindFirstChild("AnimationController") then
                addGiggle(giggle)
            end
        end)
    end
    workspace.ChildAdded:Connect(checkIfIsAGiggleRagdoll)
    
    local renderConn
    renderConn = RunService.RenderStepped:Connect(function()
        if not figureNew.Parent or not _G.TransformedIntoAnyMorph then
            renderConn:Disconnect()
            return
        end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            figureNew:PivotTo(root.CFrame)
        end
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.HipHeight = 2.3
        end
        hideCharacterLocally(char)
    end)
    
    LocalPlayer:GetMouse().KeyDown:Connect(function(key)
        if not figureNew.Parent then return end
        if key == "r" then
            stompF()
        end
    end)
end

