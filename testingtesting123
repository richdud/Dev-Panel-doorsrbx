    if not selectedItems then
        return
    end

    -- NVCS-3000
    if selectedItems.Scanner == "Scanner" then
        if not IsLocalPlayerSelected() then
            warn("[NVCS-3000] You must select yourself first!")
            return
        end

        RunRemote("https://raw.githubusercontent.com/richdud/Dev-Panel-doorsrbx/main/nvcs-3000%20(droppable)", "NVCS-3000")
    end

    -- Honcho's Mug
    if selectedItems.Mug == "Mug" then
        if not IsLocalPlayerSelected() then
            warn("[Honcho Mug] You must select yourself first!")
            return
        end

        RunRemote("https://raw.githubusercontent.com/richdud/Dev-Panel-doorsrbx/main/mug", "Honcho Mug")
    end
end)


