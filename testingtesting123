task.spawn(function()
    local drops = workspace:WaitForChild("Drops", 30)
    if not drops then return end
    drops.ChildAdded:Connect(function(drop)
        task.wait(0.1)
        local name = tostring(drop:GetAttribute("Pickup") or drop.Name)
        if not (name:find("Scanner") or name:find("NVCS")) then return end
        for _, w in ipairs(drop:GetChildren()) do
            if w:IsA("Weld") and w.Part1 and w.Part1.Name ~= "ItemDropPickup" then
                w.C0 = w.C0 * CFrame.Angles(0, 0, math.rad(90))
            end
        end
    end)
end)

