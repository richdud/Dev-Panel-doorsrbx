  local function fetchHonchoRig()
    if not isfolder("assets") then makefolder("assets") end
    if not isfolder("assets/upio") then makefolder("assets/upio") end
    local path = "assets/upio/HonchoRig.rbxm"
    if not isfile(path) or readfile(path) == "" then
      writefile(path, game:HttpGet("https://kardin-hong-upio-assets.pages.dev/HonchoRig.rbxm"))
    end
    return game:GetObjects(getcustomasset(path))[1]
  end

  local HonchoRigCache

  local function transformIntoHoncho()
    if _G.TransformedIntoAnyMorph then return end
    _G.TransformedIntoAnyMorph = true

    local player = game.Players.LocalPlayer
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then
      warn("Honcho: character not ready")
      _G.TransformedIntoAnyMorph = false
      return
    end

    if not HonchoRigCache then
      local ok, rig = pcall(fetchHonchoRig)
      if not ok or not rig then
        warn("Honcho: failed to load HonchoRig.rbxm", rig)
        _G.TransformedIntoAnyMorph = false
        return
      end
      HonchoRigCache = rig
    end

    local honcho = trackMorphModel(HonchoRigCache:Clone())
    honcho.Name = "HonchoRigLive"
    for _, part in ipairs(honcho:GetDescendants()) do
      if part:IsA("BasePart") then
        part.CanCollide = false
        part.Massless = true
        part.Anchored = (part.Name == "RootPart")
      end
    end
    honcho.Parent = workspace
    honcho:PivotTo(root.CFrame)

    local rigBox, rigSize = honcho:GetBoundingBox()
    local rigRoot = honcho.PrimaryPart or honcho:FindFirstChild("RootPart")
    local charBox, charSize = character:GetBoundingBox()
    local lift = CFrame.identity
    if rigRoot then
      local honchoHip = rigRoot.Position.Y - (rigBox.Position.Y - rigSize.Y / 2)
      local playerHip = root.Position.Y - (charBox.Position.Y - charSize.Y / 2)
      lift = CFrame.new(0, honchoHip - playerHip, 0)
    end

    local controller = honcho:FindFirstChildOfClass("AnimationController")
    local animator = controller and (controller:FindFirstChildOfClass("Animator") or Instance.new("Animator", controller))
    local animFolder = honcho:FindFirstChild("Animations")
    local idleTrack, runTrack, hitTrack
    if animator and animFolder then
      local idleAnim = animFolder:FindFirstChild("Idle")
      local runAnim = animFolder:FindFirstChild("Run")
      local hitAnim = animFolder:FindFirstChild("Entity_Hit")
      if idleAnim then
        idleTrack = animator:LoadAnimation(idleAnim)
        idleTrack.Looped = true
        idleTrack:Play()
      end
      if runAnim then
        runTrack = animator:LoadAnimation(runAnim)
        runTrack.Looped = true
      end
      if hitAnim then
        hitTrack = animator:LoadAnimation(hitAnim)
        hitTrack.Looped = false
        hitTrack.Priority = Enum.AnimationPriority.Action
      end
    end

    local renderConn
    renderConn = game:GetService("RunService").RenderStepped:Connect(function()
      if not honcho.Parent or not _G.TransformedIntoAnyMorph then
        renderConn:Disconnect()
        return
      end
      local char = player.Character
      local r = char and char:FindFirstChild("HumanoidRootPart")
      local hum = char and char:FindFirstChildOfClass("Humanoid")
      if r then
        honcho:PivotTo(r.CFrame * lift)
      end
      hideCharacterLocally(char)

      if hum and not (hitTrack and hitTrack.IsPlaying) then
        if hum.MoveDirection.Magnitude > 0.1 then
          if runTrack and not runTrack.IsPlaying then runTrack:Play(0.15) end
          if idleTrack and idleTrack.IsPlaying then idleTrack:Stop(0.15) end
        else
          if idleTrack and not idleTrack.IsPlaying then idleTrack:Play(0.15) end
          if runTrack and runTrack.IsPlaying then runTrack:Stop(0.15) end
        end
      end
    end)

    local inputConn
    inputConn = game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
      if not honcho.Parent or not _G.TransformedIntoAnyMorph then
        inputConn:Disconnect()
        return
      end
      if processed or not hitTrack then return end
