local RunService = game:GetService("RunService")
local BIND = "DoorsThirdPersonToggle"
local DISTANCE = 10

local function toggleThirdPerson()
    if _G.__tpOn then
        _G.__tpOn = false

        pcall(function()
            RunService:UnbindFromRenderStep(BIND)
        end)

        if _G.__tpCharConn then
            _G.__tpCharConn:Disconnect()
            _G.__tpCharConn = nil
        end

        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.CameraMaxZoomDistance = 0.5
        LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson

        print("[Camera] first person")
        return
    end

    _G.__tpOn = true

    LocalPlayer.CameraMode = Enum.CameraMode.Classic
    LocalPlayer.CameraMinZoomDistance = 0.5
    LocalPlayer.CameraMaxZoomDistance = 128

    _G.__tpCharConn = LocalPlayer.CharacterAdded:Connect(function()
        if not _G.__tpOn then return end

        task.wait(0.3)

        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.CameraMaxZoomDistance = 128
    end)

    local acc = 0

    RunService:BindToRenderStep(
        BIND,
        Enum.RenderPriority.Camera.Value + 1,
        function(dt)
            if not _G.__tpOn then return end

            local cam = workspace.CurrentCamera
            if not cam then return end

            acc += dt

            if acc >= 0.5 then
                acc = 0
                LocalPlayer.CameraMode = Enum.CameraMode.Classic
                LocalPlayer.CameraMaxZoomDistance = 128
            end

            cam.CFrame = cam.CFrame * CFrame.new(0, 0, DISTANCE)
        end
    )

    print("[Camera] third person")
end

