      resetMorph()
      return
    end
    local controller = groundskeeper:FindFirstChildWhichIsA("AnimationController", true)
    local gkHumanoid = groundskeeper:FindFirstChildWhichIsA("Humanoid", true)
    local animator
    if controller then
      animator = controller:FindFirstChildOfClass("Animator") or Instance.new("Animator", controller)
    elseif gkHumanoid then
      animator = gkHumanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", gkHumanoid)
    end
    if not animator then
      warn("Groundskeeper: No Animator found")
      resetMorph()
      return
    end
    local function loadTrack(anim, priority)
      local ok, track = pcall(function()
        return animator:LoadAnimation(anim)
      end)
      if ok and track then
        track.Looped = true
        track.Priority = priority or Enum.AnimationPriority.Movement
        return track
      end
      return nil
    end
    local idleTrack, walkTrack
    for _, item in ipairs(groundskeeper:GetDescendants()) do
      if item:IsA("Animation") then
        local name = string.lower(item.Name)
        if (name:find("idle") or name:find("stand")) and not idleTrack then
          idleTrack = loadTrack(item, Enum.AnimationPriority.Idle)
        elseif (name:find("walk") or name:find("run") or name:find("move")) and not walkTrack then
          walkTrack = loadTrack(item, Enum.AnimationPriority.Movement)
        end
      end
    end
    playAllSoundsInModel(groundskeeper)
    local function setMoving(shouldMove, speed)
      if not groundskeeper.Parent then return end
      if shouldMove then
        if idleTrack and idleTrack.IsPlaying then idleTrack:Stop(0.25) end
        if walkTrack then
          if not walkTrack.IsPlaying then walkTrack:Play(0.25) end
          walkTrack:AdjustSpeed(math.clamp((speed or 8) / 10, 0.7, 1.6))
        end
      else
        if walkTrack and walkTrack.IsPlaying then walkTrack:Stop(0.25) end
        if idleTrack and not idleTrack.IsPlaying then
          idleTrack:Play(0.25)
        end
      end
    end
    if idleTrack then
      idleTrack:Play(0.3)
    elseif walkTrack then
      walkTrack:Play(0)
      walkTrack:AdjustSpeed(0.1)
    end
    local renderConnection
    renderConnection = RunService.RenderStepped:Connect(function()
      if not groundskeeper.Parent or not _G.TransformedIntoAnyMorph then
        renderConnection:Disconnect()
        return
      end
      character = player.Character
      root = character and character:FindFirstChild("HumanoidRootPart")
      if root then
        groundskeeper:PivotTo(root.CFrame * CFrame.new(0, 2.4, 0))
      end
      hideCharacterLocally(player.Character)
    end)
    local runningConnection
    runningConnection = humanoid.Running:Connect(function(speed)
      if not groundskeeper.Parent or not _G.TransformedIntoAnyMorph then
        runningConnection:Disconnect()
        return
      end
      setMoving(speed >= 1, speed)
    end)
