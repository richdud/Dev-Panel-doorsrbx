local function RunRemote(url, tag)
    task.spawn(function()
        local success, err = pcall(function()
            local source = game:HttpGet(url)
            assert(type(source) == "string" and #source > 0, tag .. " source is empty")
            local compiled, compileError = loadstring(source)
            assert(compiled, compileError)
            compiled()
        end)
        if not success then
            warn("[" .. tag .. "] Launch failed:", err)
        end
    end)
end

